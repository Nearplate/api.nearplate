{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "..",
	"roots": ["<rootDir>/test/e2e/specs"],
	"testRegex": "\\.e2e-spec\\.ts$",
	"transform": {
		"^.+\\.(t|j)s$": [
			"ts-jest",
			{
				"tsconfig": "<rootDir>/test/tsconfig.json"
			}
		]
	},
	"moduleNameMapper": {
		"^@/(.*)$": "<rootDir>/src/$1",
		"^@db/(.*)$": "<rootDir>/db/$1"
	},
	"testEnvironment": "node",
	"setupFiles": ["<rootDir>/test/e2e/setup/apply-test-env.cjs"],
	"setupFilesAfterEnv": ["<rootDir>/test/e2e/setup/jest.setup.ts"],
	"globalSetup": "<rootDir>/test/e2e/setup/global-setup.cjs",
	"testTimeout": 30000,
	"maxWorkers": 1
}
