NODE_ENV="development"
LOG_LEVEL="info"
# Optional. When set, Winston also pushes to Loki.
# LOKI_HOST=http://localhost:3100

SERVER_APP_HTTP_PORT="8080"
# The single browser origin allowed by CORS.
CORS_ORIGIN="http://localhost:3030"

DATABASE_URL="postgres://postgres:postgres@localhost:5432/api_nearplate"

# Cache Redis -- used by RedisCacheAdapter / @DBCache.
REDIS_URI="redis://localhost:6379"

# One access-token secret per role, so a token for one role cannot pass as another.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ADMIN_ACCESS_SECRET="change-me-admin-access"
JWT_ADMIN_ACCESS_TTL_SECONDS="900"
JWT_RESTAURANT_ACCESS_SECRET="change-me-restaurant-access"
JWT_RESTAURANT_ACCESS_TTL_SECONDS="900"
JWT_USER_ACCESS_SECRET="change-me-user-access"
JWT_USER_ACCESS_TTL_SECONDS="900"
# Guests hold a long-lived anonymous token.
JWT_GUEST_ACCESS_SECRET="change-me-guest-access"
JWT_GUEST_ACCESS_TTL_SECONDS="2592000"

# The web app. Magic links point here, never at this API (link scanners would
# burn a GET on an API route). The web app POSTs the token to /auth/magic-link/verify.
WEB_APP_BASE_URL="http://localhost:3030"
WEB_APP_MAGIC_PATH="/auth/magic"

MAGIC_LINK_TTL_SECONDS="900"
MAGIC_LINK_MAX_PER_EMAIL_PER_HOUR="5"
# Refresh-token lifetime (opaque tokens, hashed in auth_sessions, rotated on use).
SESSION_TTL_SECONDS="2592000"
# How long a Google OAuth state/PKCE verifier stays redeemable.
OAUTH_STATE_TTL_SECONDS="600"

# Google sign-in (Authorization Code + PKCE). All three are required -- there is
# no reduced-functionality mode. GOOGLE_REDIRECT_URI is the WEB APP's callback
# route (never this API); it must also be listed in the OAuth client's
# Authorized redirect URIs in Google Cloud Console. NEVER commit a real secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3030/auth/google/callback"

# Magic-link email via Resend. Unset in development = the link is logged instead
# of sent. REQUIRED when NODE_ENV=production. NEVER commit a real key.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nearplate <noreply@nearplate.co.in>"

# Public S3 (or S3-compatible: MinIO, R2) bucket for restaurant logo/banner
# uploads. The bucket must allow public s3:GetObject and CORS POST from
# WEB_APP_BASE_URL. S3_PUBLIC_BASE_URL is the origin object URLs are built
# from (the bucket's own origin, or a CDN in front of it).
S3_IMAGE_BUCKET="nearplate-uploads"
# Private bucket for restaurant KYC documents (same region/endpoint/credentials
# as S3_IMAGE_BUCKET). It must NOT allow public reads; documents are served only
# via short-lived presigned GET URLs. Needs CORS POST from WEB_APP_BASE_URL.
S3_DOCUMENTS_BUCKET="documents"
S3_REGION="ap-south-1"
S3_PUBLIC_BASE_URL="https://nearplate-uploads.s3.ap-south-1.amazonaws.com"
# Only for S3-compatible services (MinIO, R2); leave unset for real AWS S3.
S3_ENDPOINT=
# Set "true" for S3-compatible services that lack per-bucket hostnames (MinIO,
# Supabase Storage); otherwise the TLS handshake to <bucket>.<host> fails.
S3_FORCE_PATH_STYLE="true"
# Optional. Unset uses the AWS default credential chain (instance role, etc).
# NEVER commit real credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# How long a presigned upload URL stays usable, and how long an uploaded file
# is kept if the owner never saves the form (swept by UploadCleanupSubscriber).
UPLOAD_URL_TTL_SECONDS="600"
UPLOAD_PENDING_TTL_SECONDS="3600"
# How long a presigned GET URL for a private KYC document stays valid.
DOCUMENT_URL_TTL_SECONDS="300"

# REQUIRED. AES-256-GCM key that encrypts KYC bank account and PAN numbers at
# rest: 32 random bytes, base64. Changing it makes stored values unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit a real key.
KYC_ENCRYPTION_KEY=
