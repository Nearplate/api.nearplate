NODE_ENV="development"
LOG_LEVEL="info"
# Optional. When set, Winston also pushes to Loki.
# LOKI_HOST=http://localhost:3100

SERVER_APP_HTTP_PORT="8080"
# The single browser origin allowed by CORS.
CORS_ORIGIN="http://localhost:3030"

MONGODB_URI="mongodb://localhost:27017/api_nearplate"

# Cache Redis -- used by RedisCacheAdapter / @DBCache.
REDIS_HOST="localhost"
REDIS_PORT="6379"

# One access-token secret per role, so a token for one role cannot pass as another.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ADMIN_ACCESS_SECRET="change-me-admin-access"
JWT_ADMIN_ACCESS_TTL_SECONDS="900"
JWT_RESTAURANT_ACCESS_SECRET="change-me-restaurant-access"
JWT_RESTAURANT_ACCESS_TTL_SECONDS="900"
JWT_USER_ACCESS_SECRET="change-me-user-access"
JWT_USER_ACCESS_TTL_SECONDS="900"
# Guests hold a long-lived anonymous token.
JWT_GUEST_ACCESS_SECRET="change-me-guest-access"
JWT_GUEST_ACCESS_TTL_SECONDS="2592000"

# The web app. Magic links point here, never at this API (link scanners would
# burn a GET on an API route). The web app POSTs the token to /auth/magic-link/verify.
WEB_APP_BASE_URL="http://localhost:3030"
WEB_APP_MAGIC_PATH="/auth/magic"

MAGIC_LINK_TTL_SECONDS="900"
MAGIC_LINK_MAX_PER_EMAIL_PER_HOUR="5"
# Refresh-token lifetime (opaque tokens, hashed in auth_sessions, rotated on use).
SESSION_TTL_SECONDS="2592000"
# How long a Google OAuth state/PKCE verifier stays redeemable.
OAUTH_STATE_TTL_SECONDS="600"

# Google sign-in (Authorization Code + PKCE). All three are required -- there is
# no reduced-functionality mode. GOOGLE_REDIRECT_URI is the WEB APP's callback
# route (never this API); it must also be listed in the OAuth client's
# Authorized redirect URIs in Google Cloud Console. NEVER commit a real secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3030/auth/google/callback"

# Magic-link email via Resend. Unset in development = the link is logged instead
# of sent. REQUIRED when NODE_ENV=production. NEVER commit a real key.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nearplate <noreply@nearplate.co.in>"
