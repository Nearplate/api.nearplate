NODE_ENV=development
LOG_LEVEL=info
# Optional. When set, Winston also pushes to Loki.
# LOKI_HOST=http://localhost:3100

SERVER_APP_HTTP_PORT=3000
# The single browser origin allowed by CORS.
CORS_ORIGIN=http://localhost:3400

MONGODB_URI=mongodb://localhost:27017/api_nearplate

# Cache Redis -- used by RedisCacheAdapter / @DBCache.
REDIS_HOST=localhost
REDIS_PORT=6379

# One access-token secret per role, so a token for one role cannot pass as another.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ADMIN_ACCESS_SECRET=change-me-admin-access
JWT_ADMIN_ACCESS_TTL_SECONDS=900
JWT_RESTAURANT_ACCESS_SECRET=change-me-restaurant-access
JWT_RESTAURANT_ACCESS_TTL_SECONDS=900
JWT_USER_ACCESS_SECRET=change-me-user-access
JWT_USER_ACCESS_TTL_SECONDS=900
# Guests hold a long-lived anonymous token.
JWT_GUEST_ACCESS_SECRET=change-me-guest-access
JWT_GUEST_ACCESS_TTL_SECONDS=2592000

# Sample cron: purge completed todos older than N days (daily, 03:00).
TODO_CLEANUP_CRON_ENABLED=true
TODO_CLEANUP_AFTER_DAYS=30
