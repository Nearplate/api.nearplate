{
	"name": "api.nearplate",
	"version": "0.1.0",
	"description": "Nearplate API server (NestJS + Postgres)",
	"author": "sboy99 <shadowboy191@gmail.com>",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepare": "husky || true",
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/src/main",
		"lint": "eslint \"{src,test,db}/**/*.ts\" --fix",
		"lint:check": "eslint \"{src,test,db}/**/*.ts\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "npm run test:e2e",
		"test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
		"test:deps": "docker compose -f test/docker-compose.yml up -d --wait",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1141.0",
		"@aws-sdk/s3-presigned-post": "^3.1141.0",
		"@aws-sdk/s3-request-presigner": "^3.1145.0",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.0.0",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/schedule": "^6.1.3",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"express": "^4.22.1",
		"ioredis": "^5.3.2",
		"jsonwebtoken": "^9.0.3",
		"nest-winston": "1.10.2",
		"pg": "^8.23.0",
		"qrcode": "^1.5.4",
		"reflect-metadata": "^0.1.13",
		"rxjs": "^7.8.1",
		"winston": "3.19.0",
		"winston-loki": "6.1.7",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.2",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^20.3.1",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@types/supertest": "^7.2.1",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.0.0",
		"globals": "^15.0.0",
		"husky": "^9.1.7",
		"jest": "^29.5.0",
		"prettier": "^3.3.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.1.3",
		"typescript-eslint": "^8.0.0"
	}
}
